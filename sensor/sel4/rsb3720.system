<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: BSD-3-Clause -->
<!--
  A BMP280 on the RSB-3720's I2C4, which the board routes to the UIO2
  header (pin 16 SDA, pin 18 SCL). Only i2c_imx maps the controller's
  registers and takes its interrupt (SPI 38); only timer maps GPT1 and takes
  its interrupt (SPI 55). bmp280 maps no device and reaches the bus through
  i2c_imx; consumer sees only samples. Every call goes to a strictly higher
  priority. The boot loader leaves the controller clocked; its pads must be
  muxed to I2C, and GPT1 clocked, before the image starts.

  i2c_imx and bmp280 each serve exactly one client: one channel only may
  have its pp="true" end calling each. Both block inside the call they are
  serving, so a second domain calling either would be left inactive, with
  no fault and nothing logged. Another client of i2c_imx needs a bus
  multiplexer in front of it first. timer never blocks in a call and gives
  each client one of GPT1's three compares: i2c_imx the first, bmp280 the
  second. A third client may have the third compare, but a channel here is
  not enough: timer's CLIENTS table needs an entry for it, and common its
  channel constants. Without them timer answers its calls with ERR_REQUEST,
  which the client's TimerClient takes for a timer that does not count, so
  the client would spin or poll with nothing logged. A fourth client needs
  another timer.
-->
<system>
    <memory_region name="i2c4_regs" size="0x1000" phys_addr="0x30a50000" />
    <memory_region name="gpt1_regs" size="0x1000" phys_addr="0x302d0000" />

    <protection_domain name="timer" priority="254">
        <program_image path="timer.elf" />
        <map mr="gpt1_regs" vaddr="0x2000000" perms="rw" cached="false" setvar_vaddr="gpt_regs" />
        <irq irq="87" id="0" />
    </protection_domain>

    <protection_domain name="i2c_imx" priority="253">
        <program_image path="i2c-imx.elf" />
        <map mr="i2c4_regs" vaddr="0x2000000" perms="rw" cached="false" setvar_vaddr="i2c_regs" />
        <irq irq="70" id="1" />
    </protection_domain>

    <protection_domain name="bmp280" priority="200">
        <program_image path="bmp280.elf" />
    </protection_domain>

    <protection_domain name="consumer" priority="100">
        <program_image path="consumer.elf" />
    </protection_domain>

    <channel>
        <end pd="i2c_imx" id="2" pp="true" />
        <end pd="timer" id="1" />
    </channel>

    <channel>
        <end pd="bmp280" id="2" pp="true" />
        <end pd="timer" id="2" />
    </channel>

    <channel>
        <end pd="bmp280" id="0" pp="true" />
        <end pd="i2c_imx" id="0" />
    </channel>

    <channel>
        <end pd="consumer" id="0" pp="true" />
        <end pd="bmp280" id="1" />
    </channel>
</system>
